#!/bin/sh
# Separate from 50-tvweb, which Glasshouse replaces during updates.
THEME_DIR=/var/lib/glasshouse-home-theme
THEME_PID=/var/run/glasshouse-home-theme.pid
cd / || exit 1
[ -x /usr/bin/node ] && [ -f "$THEME_DIR/guard.js" ] && [ -f "$THEME_DIR/patch.json" ] || exit 0
[ ! -e "$THEME_DIR/disabled" ] || exit 0
pid=$(cat "$THEME_PID" 2>/dev/null)
case "$pid" in
  ''|*[!0-9]*) ;;
  *) if kill -0 "$pid" 2>/dev/null && tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fxq "$THEME_DIR/guard.js"; then exit 0; fi ;;
esac
# Discard only this guard's stale pid record; never signal the process it names.
rm -f "$THEME_PID"
/sbin/start-stop-daemon -S -b -m -p "$THEME_PID" -x /usr/bin/node -- "$THEME_DIR/guard.js"
